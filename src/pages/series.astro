---
import Main from "../layouts/Main.astro";

export const prerender = false;

import { Clapperboard, Star } from "@lucide/astro";

import { fetchSeries } from "../lib/airtable.ts";

import { ArrowLeftIcon } from "../components/animate-ui/ArrowLeftIcon.tsx";

import Birthday from "../components/Birthday.astro";

const allSeries = await fetchSeries();

const formattedDate = (date: string) => {
  if (!date) {
    return "";
  } else {
    return new Date(date)
      .toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      })
      .toLowerCase();
  }
};
---

<Main>
  <Birthday />
  <p>
    i'm trying to build cool stuff on the web. i'm still a beginner, but hope
    that some of my projects are useful to others
  </p>
  <div class="relative left-1/2 w-screen max-w-none -translate-x-1/2 px-6 mt-2">
    <a href="./about" class="flex w-336 max-w-full mx-auto">
      <div class="mt-2 flex items-center gap-1">
        <ArrowLeftIcon client:load size={12} />
        <p class="text-xs ml-1">back to about</p>
      </div>
    </a>
    <div
      class="relative mx-auto mt-2 w-336 max-w-full h-full rounded-lg border-2 border-[#DCDCDC] bg-[#F7F7F6]/60 px-4 py-3 text-base font-medium"
    >
      <div class="grid grid-cols-4 gap-4 mt-2 transform 200ms ease">
        {
          allSeries.map((serie) => {
            const rating = Number(serie.rating) || 0;

            return (
              <figure class="seriesElement group flex min-w-0 flex-col">
                <div class="poster relative aspect-3/4 overflow-hidden rounded-lg transition-all duration-200 ease">
                  <img
                    src={serie.src}
                    alt={serie.title}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>

                <div class="mt-2 leading-tight">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <p class="truncate text-xs font-bold">{serie.title}</p>

                      <p class="mt-0.5 truncate text-xs text-[#666666]">
                        {serie.type}
                      </p>
                    </div>
                  </div>

                  <div class="mt-1.5 flex items-center gap-px">
                    {[1, 2, 3, 4, 5].map((star) => (
                      <Star
                        size={11}
                        class:list={[
                          star <= rating
                            ? "fill-black text-black"
                            : "text-[#DCDCDC]",
                        ]}
                      />
                    ))}

                    <p class="truncate text-xs ml-1.5 mt-[0.9px]">{rating}/5</p>
                  </div>

                  <p class="mt-1.5 text-xs text-[#666666]">
                    watched on {formattedDate(serie.dateWatched)}
                  </p>

                  {serie.notes && (
                    <blockquote class="mt-3 border-l-2 border-[#DCDCDC] pl-2.5 text-xs leading-relaxed text-[#666666]">
                      <p>{serie.notes}</p>
                    </blockquote>
                  )}
                </div>
              </figure>
            );
          })
        }
      </div>
    </div>
  </div>
</Main>

<script>
  const galPhotos = document.querySelectorAll(".photoElement");

  galPhotos.forEach((photo) => {
    const container = photo.parentElement;

    container?.addEventListener("mouseenter", () => {
      const rot = Math.random() * 10 - 5;
      container.style.transform = `rotate(${rot}deg)`;
    });

    container?.addEventListener("mouseleave", () => {
      container.style.transform = `rotate(0deg)`;
    });
  });
</script>
