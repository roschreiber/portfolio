---
import Main from "../../layouts/Main.astro";
import Birthday from "../../components/Birthday.astro";
import { MessageSquareMoreIcon } from "../../components/animate-ui/MessageSquareMoreIcon.tsx";
import { MapPinIcon } from "../../components/animate-ui/MapPinIcon.tsx";
import { ArrowLeftIcon } from "../../components/animate-ui/ArrowLeftIcon.tsx";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Main>
  <Birthday />
  <p>
    i'm trying to build cool stuff on the web. i'm still a beginner, but hope
    that some of my projects are useful to others
  </p>
  <a href="./" class="flex w-336 max-w-full mx-auto">
    <div class="mt-6 flex items-center gap-1">
      <ArrowLeftIcon client:load size={12} />
      <p class="text-xs ml-1">back to blog overview</p>
    </div>
  </a>
  <div class="mt-2 relative">
    <article class="w-full mb-2">
      <div
        class="blog-txt-card relative w-full rounded-lg border-2 border-[#DCDCDC] bg-[#F7F7F6]/60 px-4 py-3 text-base font-medium"
      >
        <div class="flex w-full items-center justify-between">
          <p class="flex items-center gap-1.5 text-lg leading-tight">
            <MessageSquareMoreIcon
              className="-mb-px w-5 h-5"
              client:load
            /><span class="font-semibold">{post.data.title}</span>
          </p>
        </div>
        <hr class="mt-4 h-px border-0 bg-[#DCDCDC]" />
        <div class="prose blog-prose prose-sm sm:prose-base mt-4">
          <Content />
        </div>
      </div>
    </article>

    {
      headings.length > 0 && (
        <aside class="w-full rounded-lg border-2 border-[#DCDCDC] bg-[#F7F7F6]/60 px-3 py-3 xl:absolute xl:right-full xl:top-0 xl:mt-0 xl:mr-3 xl:w-56">
            <p class="flex items-center text-xs gap-1.5 leading-tight">
            <MapPinIcon client:load /><span class="font-semibold ml-0.5"
                >on this page</span
            >
            </p>

          <nav>
            <ul class="flex flex-col gap-1 mt-2">
              {headings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      "block rounded-md px-2 py-1.5 text-xs text-black/60 no-underline hover:bg-black/5 hover:text-black",
                      heading.depth === 2 && "ml-2",
                      heading.depth === 3 && "ml-4",
                      heading.depth === 4 && "ml-6",
                      heading.depth === 5 && "ml-8",
                      heading.depth === 6 && "ml-10",
                    ]}
                  >
                    - {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</Main>
