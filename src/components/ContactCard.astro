const mailIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="14" rx="2"/></svg>`
---

<div
    class="blog-card relative w-316 h-full rounded-lg border-2 border-[#DCDCDC] bg-[#F7F7F6]/60 px-4 py-3 text-base font-medium"
>
    <div class="flex w-full items-center justify-between">
        <p class="flex items-center gap-1 text-xs leading-tight">
            <Contact size={16} class="mb-0.2" /><span class="font-semibold"
                >my socials</span
            >
        </p>
    </div>
    <div class="grid grid-cols-1 gap-4 mt-3">
        <SocialButton
            icon={githubIcon}
            service="GitHub"
            txt="github.com/roschreiber"
            href="https://github.com/roschreiber"
        />
        <SocialButton
            icon={discordIcon}
            service="Discord"
            txt="wyarob"
            href="https://discord.com/users/316991053242564609"
        />
        <SocialButton
            icon={kofiIcon}
            service="Kofi"
            txt="for donations, commisions and so on"
            href="https://ko-fi.com/wyarob"
        />
        <SocialButton
            icon={mailIcon}
            service="Mail"
            txt="rob@byrob.me"
            href="mailto:rob@byrob.me"
        />
    </div>
</div>
