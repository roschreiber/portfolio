---
import {
    HeartPulse,
    Footprints,
    Moon,
    Timer,
    PersonStanding,
    Flame,
    ChevronsUp,
} from "@lucide/astro";

type Health = {
    stepsCount: number;
    sleepHrs: string;
    HrsStanding: number;
    ExerciseTime: number;
    kcalBurned: number;
    Floors: number;
    refresh: string;
};

const STEP_GOAL = 10000;
const SLEEP_GOAL_MIN = 480;
const STAND_GOAL = 12;

function sleepToMinutes(text: string) {
    const hours = text.match(/(\d+)\s*h/);
    const minutes = text.match(/(\d+)\s*m/);

    let total = 0;
    if (hours) {
        total = total + Number(hours[1]) * 60;
    }
    if (minutes) {
        total = total + Number(minutes[1]);
    }
    return total;
}

function percentOfGoal(value: number, goal: number) {
    const percent = Math.round((value / goal) * 100);
    if (percent > 100) {
        return 100;
    }
    return percent;
}

let stats: Health[] = [];
try {
    const res = await fetch(new URL("/api/health", Astro.url));
    if (res.ok) {
        stats = await res.json();
    }
} catch {}

const today = stats[stats.length - 1];

let refreshText = "no health data right now";

const bigStats = [
    {
        icon: Footprints,
        label: "steps",
        value: "-",
        percent: 0,
        goal: STEP_GOAL.toLocaleString("en-US"),
    },
    {
        icon: Moon,
        label: "sleep",
        value: "-",
        percent: 0,
        goal: `${SLEEP_GOAL_MIN / 60}h`,
    },
];

const smallStats = [
    { icon: Timer, label: "exercise", value: "-" },
    { icon: PersonStanding, label: "stand", value: "-" },
    { icon: Flame, label: "active kcal", value: "-" },
    { icon: ChevronsUp, label: "floors", value: "-" },
];

if (today) {
    bigStats[0].value = today.stepsCount.toLocaleString("en-US");
    bigStats[0].percent = percentOfGoal(today.stepsCount, STEP_GOAL);

    bigStats[1].value = today.sleepHrs;
    bigStats[1].percent = percentOfGoal(
        sleepToMinutes(today.sleepHrs),
        SLEEP_GOAL_MIN,
    );
    
    const n = (v: unknown) => parseFloat(String(v)) || 0;

    smallStats[0].value = `${n(today.ExerciseTime)} min`;
    smallStats[1].value = `${n(today.HrsStanding)} / ${STAND_GOAL} min`;
    smallStats[2].value = `${n(today.kcalBurned).toFixed(1)}`;
    smallStats[3].value = `${n(today.Floors)}`;

    const minutesAgo = Math.floor(
        (Date.now() - new Date(today.refresh).getTime()) / 60000,
    );
    refreshText = `last updated ${minutesAgo}m ago`;
}
---

<div
    class="blog-card relative flex h-full w-full flex-col rounded-lg border-2 border-[#DCDCDC] bg-[#F7F7F6]/60 px-4 py-3 text-base font-medium"
>
    <div class="flex w-full items-center justify-between">
        <p class="flex items-center gap-1 text-xs leading-tight">
            <HeartPulse size={16} class="mb-0.2" /><span class="font-semibold"
                >today's stats</span
            >
        </p>
        <p class="text-[10px] leading-tight opacity-80">{refreshText}</p>
    </div>
    <div class="grid grid-cols-1 gap-4 mt-1.5">
        <p class="text-sm font-medium">taken from apple health & bevel</p>
    </div>

    <div class="flex flex-1 flex-col gap-2 mt-3">
        <div class="grid flex-2 grid-cols-1 sm:grid-cols-2 gap-2">
            {
                bigStats.map((item) => (
                    <div class="h-full rounded-lg border border-[#DCDCDC] bg-[#F7F7F6]/60 px-5 py-4 flex items-center gap-5">
                        <item.icon size={36} class="shrink-0 opacity-90" />
                        <div class="flex-1 leading-tight">
                            <p class="text-sm opacity-80">{item.label}</p>
                            <p class="text-4xl font-bold">{item.value}</p>
                            <p class="text-xs opacity-80 mt-1.5">
                                {item.percent}% of {item.goal}
                            </p>
                        </div>
                        <div
                            class="stat-ring shrink-0"
                            style={`--pct:${item.percent}`}
                            aria-hidden="true"
                        />
                    </div>
                ))
            }
        </div>

        <div class="grid flex-1 grid-cols-2 sm:grid-cols-4 gap-2">
            {
                smallStats.map((item) => (
                    <div class="h-full rounded-lg border border-[#DCDCDC] bg-[#F7F7F6]/60 px-3 py-2.5 flex items-center gap-2">
                        <item.icon size={18} class="shrink-0 opacity-90" />
                        <div class="leading-tight">
                            <p class="text-xs opacity-80">{item.label}</p>
                            <p class="text-base font-bold">{item.value}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<style>
    .stat-ring {
        width: 4rem;
        height: 4rem;
        border-radius: 9999px;
        background: conic-gradient(
            rgba(0, 0, 0, 0.8) calc(var(--pct) * 1%),
            #dcdcdc 0
        );
        -webkit-mask: radial-gradient(
            farthest-side,
            transparent calc(100% - 8px),
            #000 calc(100% - 7px)
        );
        mask: radial-gradient(
            farthest-side,
            transparent calc(100% - 8px),
            #000 calc(100% - 7px)
        );
    }
</style>
